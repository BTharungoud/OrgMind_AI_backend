{
  "info": {
    "name": "AI Agent Backend - Postman Collection",
    "_postman_id": "ai-agent-backend-collection",
    "description": "Collection for the current AI Agent backend API. Set baseUrl as needed. Log in first to populate jwt and refreshToken automatically; protected endpoints use the jwt variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "description": "Backend base URL"
    },
    {
      "key": "jwt",
      "value": "",
      "description": "Bearer access token for protected requests"
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "JWT refresh token"
    },
    {
      "key": "registrationToken",
      "value": "",
      "description": "Optional token returned by Registration - Create Dev Token"
    }
  ],
